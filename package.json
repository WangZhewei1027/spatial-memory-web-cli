{
  "name": "spatial-memory-web-cli",
  "version": "0.3.0",
  "description": "Standalone CLI for Spatial Memory Web teams, collections, assets, placements and scenes",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spatial-memory": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@spatial-memory/scene-authoring": "file:vendor/spatial-memory-scene-authoring-0.2.0.tgz",
    "@spatial-memory/scene-renderer": "file:vendor/spatial-memory-scene-renderer-0.1.1.tgz"
  },
  "bundleDependencies": [
    "@spatial-memory/scene-authoring",
    "@spatial-memory/scene-renderer"
  ]
}
