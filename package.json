{
  "name": "spatial-memory-web-cli",
  "version": "0.2.1",
  "description": "Standalone CLI for Spatial Memory Web teams, collections, assets, placements and scenes",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spatial-memory": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
